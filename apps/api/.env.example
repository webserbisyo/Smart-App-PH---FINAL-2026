PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
DEMO_PASSWORD=your-secure-demo-password
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Super Admin (T88): your own login email. `pnpm --filter @smartapp/api seed:demo` marks it as the platform admin.
ADMIN_EMAIL=
# Meta Conversions API (T90). Leave empty until launch: events wait on the Tracking page.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v27.0
# Help mode (T91): a long random string that signs the 60-minute help sessions.
SUPPORT_SESSION_SECRET=
