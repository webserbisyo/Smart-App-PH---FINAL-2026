{
  "name": "@smartapp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*",
    "./compositions/*": "./src/compositions/*",
    "./lib/*": "./src/lib/*",
    "./hooks/*": "./src/hooks/*",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b tsconfig.components.json",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@base-ui/utils": "0.5.0",
    "@diceui/checkbox-group": "1.0.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@smartapp/core": "workspace:*",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "cn": "catalog:",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "catalog:",
    "motion": "14.3.0",
    "qrcode": "1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "29.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
