{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "tsBuildInfoFile": "dist/types/components.tsbuildinfo",
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/components/**/*"],
  "exclude": [
    "src/components/reui/emoji-picker.tsx",
    "src/components/reui/data-grid/data-grid-cell-selection.tsx",
    "src/components/reui/kanban.tsx",
    "src/components/reui/event-calendar/**/*"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
