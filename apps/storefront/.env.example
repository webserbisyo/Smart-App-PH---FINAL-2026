# Optional: turn the service worker on in `next dev` (off by default).
# SERWIST_DEV=1

# The owner dashboard's address: the only page that may show the Editor preview. `pnpm dev` uses
# http://localhost:5173; a build uses https://app.webserbisyo.com unless this is set.
# NEXT_PUBLIC_DASHBOARD_URL=https://app.webserbisyo.com

# Sample data or the API, area by area (mock or api; default mock).
NEXT_PUBLIC_DATA_SOURCE=mock
# development, preview (a hosted demo link with the Preview panel and noindex, T100) or production.
# NEXT_PUBLIC_APP_ENV=preview

# Launch phase 5: the NestJS address, and the areas a sample-data build takes from it (comma list, e.g.
# storefront,customerAuth). NEXT_PUBLIC_DATA_SOURCE=api takes every area.
# NEXT_PUBLIC_API_URL=https://api.webserbisyo.com
# NEXT_PUBLIC_API_AREAS=
# The shops' own addresses: <slug>.<this domain> serves the shop (wildcard domain on this Vercel project).
# NEXT_PUBLIC_SHOP_DOMAIN=webserbisyo.com
# Server only, each a long random string shared with the API (Railway): server reads skip its rate limit, and
# only the API may refresh a shop's cached pages.
# SERVER_READ_SECRET=
# STOREFRONT_REVALIDATE_SECRET=
