{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "tsBuildInfoFile": "dist/types/components-relaxed.tsbuildinfo",
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/components/reui/emoji-picker.tsx",
    "src/components/reui/data-grid/data-grid-cell-selection.tsx",
    "src/components/reui/kanban.tsx",
    "src/components/reui/color-picker.tsx",
    "src/components/reui/event-calendar/**/*"
  ],
  "exclude": [],
  "references": [
    {
      "path": "./tsconfig.components.json"
    },
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
