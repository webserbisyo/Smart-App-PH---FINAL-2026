{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "dist/types/root.tsbuildinfo",
    "paths": {
      "@smartapp/ui/components/*": ["./src/components/*"],
      "@smartapp/ui/lib/*": ["./src/lib/*"],
      "@smartapp/ui/hooks/*": ["./src/hooks/*"],
      "@smartapp/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["src/components", "src/lib", "src/hooks"],
  "references": [{ "path": "./tsconfig.lib.json" }, { "path": "./tsconfig.components.json" }]
}
