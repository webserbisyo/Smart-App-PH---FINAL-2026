{
  "name": "@smartapp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && (tsc --watch -p tsconfig.build.json & node --watch --env-file=.env.local dist/main.js)",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo-accounts.ts",
    "db:pull": "drizzle-kit pull && node scripts/fix-drizzle-pull.ts && pnpm -w exec prettier --log-level warn --write apps/api/src/db/generated && pnpm -w exec prettier --log-level warn --write apps/api/src/db/generated",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.8.0",
    "@smartapp/core": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "4.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}
