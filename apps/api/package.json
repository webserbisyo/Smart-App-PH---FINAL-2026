    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
