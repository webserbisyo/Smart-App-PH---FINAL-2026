{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@smartapp/ui/styles/*": ["../../packages/ui/src/styles/*"],
      "@smartapp/ui/components/*": ["../../packages/ui/src/components/*"],
      "@smartapp/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "@smartapp/ui/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@smartapp/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src"]
}
