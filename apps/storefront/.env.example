NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: turn the service worker on in `next dev` (off by default).
# SERWIST_DEV=1

# The owner dashboard's address: the only page that may show the Editor preview. `pnpm dev` uses
# http://localhost:5173; a build uses https://app.webserbisyo.com unless this is set.
# NEXT_PUBLIC_DASHBOARD_URL=https://app.webserbisyo.com
