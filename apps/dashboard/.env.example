# NestJS (decision T34): the login and every area in VITE_API_AREAS go here. The browser never calls Supabase.
VITE_API_URL=http://localhost:4000
VITE_STOREFRONT_URL=http://localhost:3000
VITE_SHOW_KIT=false
# Sample data or the API, area by area (mock or api; default mock).
VITE_DATA_SOURCE=mock
# With mock: the areas already on NestJS, comma-separated (T116), e.g. ownerAuth,onboarding,uploads,ownerSettings,ownerEditor.
VITE_API_AREAS=
# development (pnpm dev), preview (a hosted demo link: sample data, Preview panel, sample sign-in, T100) or
# production (a live shop's dashboard: none of those). Empty: development for `vite`, production for builds.
VITE_APP_ENV=
# Meta Pixel (dataset) ID, numbers only. Loads the pixel on /signup only (decision T90). Leave empty in dev.
VITE_META_PIXEL_ID=
# Your Facebook Page's Messenger link, shown on the sign-up page.
VITE_MESSENGER_URL=https://m.me/smartappph
