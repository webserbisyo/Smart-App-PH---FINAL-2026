# development (laptop and tests), staging (api-staging., dev database) or production (api., live database).
APP_ENV=development
PORT=4000
SUPABASE_URL=https://your-project.supabase.co
# The new secret key (sb_secret_...): Supabase › Project Settings › API Keys. Server only.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Postgres. Railway: the transaction pooler (port 6543) URL without sslmode. Laptop with `supabase start`:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Supabase › Database settings › SSL Configuration › Download certificate (paste the text or a file path).
DATABASE_CA_CERT=
DB_POOL_MAX=5
# Railway: 1 (one proxy in front of the API). Laptop: 0.
TRUST_PROXY_HOPS=0
DEMO_PASSWORD=your-secure-demo-password
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Super Admin (T88): your own login email. `pnpm --filter @smartapp/api seed:demo` marks it as the platform admin.
ADMIN_EMAIL=
# Meta Conversions API (T90). Leave empty until launch: events wait on the Tracking page.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v27.0
# Help mode (T91): a long random string that signs the 60-minute help sessions.
SUPPORT_SESSION_SECRET=
# Storefront page refresh (T117): after a menu, look or settings change, NestJS asks the storefront to drop
# that shop's cached pages. Same long random string in the storefront's STOREFRONT_REVALIDATE_SECRET. Laptop: leave empty.
STOREFRONT_URL=
STOREFRONT_REVALIDATE_SECRET=
# Shops' own addresses (launch phase 5): https://<slug>.<SHOP_DOMAIN> may call the API. Laptop: leave empty.
SHOP_DOMAIN=
# The storefront's server reads send this so the rate limit skips them. Same long random string in the
# storefront's SERVER_READ_SECRET. Laptop: leave empty.
SERVER_READ_SECRET=
# The dashboard's address, for links in the owner's pushes and emails (launch phase 5).
DASHBOARD_URL=
# Push keys (launch phase 5, one pair for every shop). Make them once with
# `node -e "import('web-push').then(w => console.log(w.generateVAPIDKeys()))"` in apps/api.
# Laptop: leave empty, and pushes are only recorded.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:codes@mail.webserbisyo.com
# The owner's emails through Resend's HTTPS API (Q4). Laptop: leave empty, and emails are only recorded.
RESEND_API_KEY=
EMAIL_FROM=Smart App PH <alerts@mail.webserbisyo.com>
